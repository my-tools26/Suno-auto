{
  "manifest_version": 3,
  "name": "Suno Auto Creator",
  "version": "2.0.0",
  "description": "Tự động tạo nhạc trên Suno: nhập lyrics + style → 1-click tạo → tự tải về",
  "author": "my-tools26",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "https://suno.com/*",
    "https://*.suno.com/*",
    "https://cdn1.suno.ai/*",
    "https://cdn2.suno.ai/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*", "https://*.suno.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
